# Copy to .env.local and fill in values (ask another developer, or pull from
# Vercel with `vercel env pull`). Without the Sanity vars the build fails with
# "Configuration must contain `projectId`".

# Sanity CMS (required). The project ID is public; the token is not.
# Jacket's Vercel Development target uses the `test` dataset.
NEXT_PUBLIC_SANITY_PROJECTID=3lm68n5v
NEXT_PUBLIC_SANITY_DATASET=test
SANITY_TOKEN=

# Fathom analytics (optional, no-op if unset)
NEXT_PUBLIC_FATHOM_SITEID=
