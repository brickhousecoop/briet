# Copy to .env.local and fill in values (ask another developer, or pull from
# Vercel with `vc env pull`). Only the Sanity vars are required to browse the
# catalog locally.

# Sanity CMS. The project ID is public; the token is not, and is required —
# both datasets are private, so without it reads return no documents. The token
# also needs write access: the order page mints redemption codes and the redeem
# endpoint marks them spent.
NEXT_PUBLIC_SANITY_PROJECTID=3lm68n5v
NEXT_PUBLIC_SANITY_DATASET=development
SANITY_TOKEN=

# Clerk auth (only needed for the /account sign-in + order-history flow).
# The sign-in/sign-up URLs are set in middleware.ts, not here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe checkout (only needed for the purchase flow)
STRIPE_SECRET_KEY=

# Where Stripe returns the buyer after payment. Must be this deployment's own
# origin, with no trailing slash — it is deliberately not read from the request,
# so it has to be set per environment (https://market.briet.app in production).
SITE_URL=http://localhost:3000

# Fathom analytics (optional, no-op if unset)
NEXT_PUBLIC_FATHOM_SITEID=
