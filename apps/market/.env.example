# Copy to .env.local and fill in values (ask another developer, or pull from
# Vercel with `vc env pull`). Only the Sanity vars are required to browse the
# catalog locally.

# Sanity CMS (required)
NEXT_PUBLIC_SANITY_PROJECTID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_TOKEN=

# Clerk auth (only needed for the /account sign-in + order-history flow).
# The SIGN_IN/UP_URLs point at this app's custom pages, not Clerk's defaults.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/account/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/account/sign-up

# Stripe checkout (only needed for the purchase flow)
STRIPE_SECRET_KEY=

# Fathom analytics (optional, no-op if unset)
NEXT_PUBLIC_FATHOM_SITEID=
